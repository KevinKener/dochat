# DocChat — Variables de entorno
# Copiá este archivo como .env y completá los valores

# ─── LLM ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
# Modelo para generación. Opciones: claude-3-haiku-20240307 | claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ─── Embeddings ────────────────────────────────────────────────────────────
# Opcional — si no está, usa sentence-transformers local (más lento, menor calidad)
OPENAI_API_KEY=sk-
# Modelo de embeddings. No cambiar si ya hay docs indexados (breaking change)
EMBEDDING_MODEL=text-embedding-3-small

# ─── Vector store ──────────────────────────────────────────────────────────
# Para ChromaDB local (MVP)
CHROMA_PERSIST_PATH=./chroma_data

# Para pgvector (Fase 2+) — dejar vacío si usás Chroma
# DATABASE_URL=postgresql://user:password@localhost:5432/dochat

# ─── RAG config ────────────────────────────────────────────────────────────
# Tamaño de cada chunk en caracteres
CHUNK_SIZE=1000
# Superposición entre chunks consecutivos (para no perder contexto en los cortes)
CHUNK_OVERLAP=200
# Cuántos chunks recuperar por query
RETRIEVAL_TOP_K=4
# Temperatura del LLM (0 = más determinista, 1 = más creativo)
LLM_TEMPERATURE=0.1

# ─── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=50
# Tipos de archivo permitidos (separados por coma)
ALLOWED_EXTENSIONS=pdf,docx,txt
